# Truemail server configuration.
# Copy to .env and fill in. Full option list:
# https://truemail-rb.org/truemail-rack/#/starting-the-server?id=configurable-options

# REQUIRED. Must be an existing email on behalf of which verification is
# performed -- it becomes the MAIL FROM in the SMTP conversation.
#
# For the truemail_mx service this value is never sent anywhere: the DNS/MX
# layer does not open an SMTP session, so a placeholder is fine.
# For the truemail_smtp service it MUST be a real, deliverable address on a
# domain whose IP has a matching PTR record, or receiving servers will
# distrust the probe and results will be worthless.
VERIFIER_EMAIL=verifier@example.com

# REQUIRED. Token-based auth for the API. Comma-separated for multiple.
ACCESS_TOKENS=replace-me

# Optional. Defaults to the domain of VERIFIER_EMAIL.
# VERIFIER_DOMAIN=yourdomain.com

# Optional. Custom DNS gateways, comma-separated, :port optional (default 53).
DNS=1.1.1.1,8.8.8.8

# Optional timeouts in SECONDS (both default to 2).
CONNECTION_TIMEOUT=2
RESPONSE_TIMEOUT=2
CONNECTION_ATTEMPTS=2

# Optional, SMTP layer only. See notes in docker-compose.yml.
SMTP_FAIL_FAST=true
SMTP_SAFE_CHECK=true

# Log every HTTP request to stdout.
LOG_STDOUT=true

# Server replicas per layer. Each container is serial, so this -- not client
# threads -- is what sets real concurrency. Max 10 per layer (port range).
MX_REPLICAS=1
SMTP_REPLICAS=1
